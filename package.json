{
  "name": "gsy-github-app-uniapp",
  "version": "2.0.0-uniapp.0",
  "description": "GSYGithubApp 的 uni-app 版（Vue 3 + Vite），原 Weex 版已归档",
  "private": true,
  "author": "CarGuo",
  "license": "MIT",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-deps-cooldown.mjs",
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "lint": "echo \"lint pending\"",
    "type-check": "vue-tsc --noEmit",
    "verify:cooldown": "node scripts/check-deps-cooldown.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5000720260410001",
    "@dcloudio/uni-app-plus": "3.0.0-5000720260410001",
    "@dcloudio/uni-components": "3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5000720260410001",
    "@dcloudio/uni-ui": "1.5.12",
    "axios": "1.16.0",
    "dayjs": "1.11.20",
    "pinia": "3.0.4",
    "vue": "3.5.33",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.28",
    "@dcloudio/uni-automator": "3.0.0-5000720260410001",
    "@dcloudio/uni-cli-shared": "3.0.0-5000720260410001",
    "@dcloudio/uni-stacktracey": "3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5000720260410001",
    "@vue/runtime-core": "3.5.33",
    "@vue/tsconfig": "0.9.1",
    "sass": "1.99.0",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vue-tsc": "3.2.7"
  },
  "uni-app": {
    "scripts": {}
  }
}
