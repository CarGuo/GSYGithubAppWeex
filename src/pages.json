      }
    },
    {
      "path": "pages/dynamic/index",
      "style": {
        "navigationBarTitleText": "动态"
      }
    },
    {
      "path": "pages/repository-detail/index",
      "style": {
        "navigationBarTitleText": "仓库详情"
      }
    },
    {
      "path": "pages/repository-detail-info/index",
